# ─────────────────────────────────────────────────────────────────────────────
# Semantic RAG Engine — MVP  |  Copia questo file in .env e personalizza
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# In produzione usa endpoint esterno, es: s3.eu-west-1.amazonaws.com
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=rag-documents

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb
# DSN composto automaticamente dal compose; sovrascrivibile per DB esterno:
# POSTGRES_DSN=postgresql://raguser:ragpassword@localhost:5432/ragdb

# ── Qdrant (Vector Store) ─────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=pdf_chunks

# ── Redis (Semantic Cache) ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600

# ── OpenSearch (BM25) ─────────────────────────────────────────────────────────
OPENSEARCH_URL=http://opensearch:9200

# ── Neo4j (Knowledge Graph) ───────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Ollama (LLM + Embedding) ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
# Modello generativo — deve essere pullato con: make pull-models
CHAT_MODEL=gemma4
# Modello embedding (768 dimensioni)
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ── Pipeline RAG ──────────────────────────────────────────────────────────────
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=80
TOP_K=5

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# IMPORTANTE: cambia questo valore in produzione con una stringa random lunga
JWT_SECRET_KEY=super-secret-rag-engine-dev-key-change-in-prod-2026
JWT_EXPIRE_MINUTES=60

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL del backend visto dal container frontend (usa nome servizio Docker)
API_BASE=http://backend:8000
# Per sviluppo locale senza Docker:
# API_BASE=http://localhost:8000
